{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a5_k2_candidate_evidence_v2",
  "title": "Fail-closed owner-produced K2 evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate", "vector_bundle_sha256", "runs"],
  "properties": {
    "schema": {"const": "a5_k2_candidate_evidence_v2"},
    "vector_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "binding", "runner", "contract", "claims"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/fileRecord"},
        "binding": {"$ref": "#/$defs/fileRecord"},
        "runner": {"$ref": "#/$defs/fileRecord"},
        "contract": {
          "type": "object", "additionalProperties": false,
          "required": ["policy", "edge", "latency"],
          "properties": {
            "policy": {
              "type": "object", "additionalProperties": false,
              "required": ["class", "definition"],
              "properties": {
                "class": {"enum": ["exact_weighted_scalar_prefix_k2", "batched_iwrr_k2", "paired_row_calendar_proposal_k2"]},
                "definition": {"type": "string", "minLength": 1}
              }
            },
            "edge": {"type": "object"},
            "latency": {"type": "object"}
          }
        },
        "claims": {
          "type": "object", "additionalProperties": false,
          "required": ["full_future_trace_equivalence"],
          "properties": {"full_future_trace_equivalence": {"type": "boolean"}}
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "run_sha256", "artifact"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "run_sha256": {"$ref": "#/$defs/sha256"},
          "artifact": {"$ref": "#/$defs/sha256FileRecord"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest_kind", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest_kind": {"enum": ["sha256", "git_blob_sha1"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
      }
    },
    "sha256FileRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest_kind", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest_kind": {"const": "sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
