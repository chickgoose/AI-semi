{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redred.invalid/schemas/mc_wtb_predictor_stage3_screen108_result_v1.json",
  "title": "Locked candidate-neutral MC-WTB NEW108 screen result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "candidate_id", "cohort", "provenance", "cncp",
    "groups", "windows", "gate", "claim_scope", "result_sha256"
  ],
  "properties": {
    "schema": {"const": "redred.mc_wtb_predictor_stage3.screen108_result/v1"},
    "status": {
      "enum": [
        "SCREEN108_MEASURED_PROMOTION_NOT_AUTHORIZED",
        "SCREEN108_METRICS_HOLD"
      ]
    },
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "cohort": {"$ref": "#/$defs/cohort"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "cncp": {"$ref": "#/$defs/cncp"},
    "groups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/group_overall"},
        {"$ref": "#/$defs/group_low"},
        {"$ref": "#/$defs/group_mid"},
        {"$ref": "#/$defs/group_high"}
      ],
      "items": false
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/window"}
    },
    "gate": {"$ref": "#/$defs/gate"},
    "claim_scope": {"$ref": "#/$defs/claim_scope"},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.:/,+-]{0,510}[A-Za-z0-9])?$"
    },
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "finite_number": {"type": "number"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "source_members": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "poses", "calibration"],
      "properties": {
        "events": {"$ref": "#/$defs/sha256"},
        "poses": {"$ref": "#/$defs/sha256"},
        "calibration": {"$ref": "#/$defs/sha256"}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_id", "role", "window_count", "selected_event_count",
        "query_event_count", "selected_pose_packet_count", "pre_roll_ns",
        "ordered_query_ids_sha256"
      ],
      "properties": {
        "sequence_id": {"const": "uzh_davis240c/shapes_rotation"},
        "role": {"const": "DEVELOPMENT_CONSUMED"},
        "window_count": {"type": "integer", "minimum": 1},
        "selected_event_count": {"type": "integer", "minimum": 1},
        "query_event_count": {"type": "integer", "minimum": 1},
        "selected_pose_packet_count": {"type": "integer", "minimum": 1},
        "pre_roll_ns": {"const": 50000000},
        "ordered_query_ids_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage12_freeze_receipt_sha256", "stage12_source_split_plan_sha256",
        "stage12_contract_sha256", "stage12_architecture_sha256",
        "source_member_sha256", "selector_registry_sha256",
        "selector_implementation_sha256", "adapter_aggregate_sha256",
        "adapter_implementation_sha256", "neutral_registry_sha256",
        "selector_labels_sidecar_sha256", "neutral_input_sha256",
        "evaluator_implementation_sha256", "screen_runner_implementation_sha256",
        "result_schema_sha256", "candidate_output_sha256",
        "candidate_executable_sha256", "candidate_config_sha256"
      ],
      "properties": {
        "stage12_freeze_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "stage12_source_split_plan_sha256": {"$ref": "#/$defs/sha256"},
        "stage12_contract_sha256": {"$ref": "#/$defs/sha256"},
        "stage12_architecture_sha256": {"$ref": "#/$defs/sha256"},
        "source_member_sha256": {"$ref": "#/$defs/source_members"},
        "selector_registry_sha256": {"$ref": "#/$defs/sha256"},
        "selector_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "neutral_registry_sha256": {"$ref": "#/$defs/sha256"},
        "selector_labels_sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "neutral_input_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "screen_runner_implementation_sha256": {"$ref": "#/$defs/sha256"},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_output_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_executable_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "operation_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add_compare", "fixed_multiply", "nonlinear"],
      "properties": {
        "add_compare": {"$ref": "#/$defs/nonnegative_integer"},
        "fixed_multiply": {"$ref": "#/$defs/nonnegative_integer"},
        "nonlinear": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "cncp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_grade", "verdict", "declared_values"],
      "properties": {
        "evidence_grade": {"const": "DECLARED_UNVERIFIED"},
        "verdict": {"const": "CNCP_HOLD_UNVERIFIED"},
        "declared_values": {"$ref": "#/$defs/cncp_declared_values"}
      }
    },
    "cncp_declared_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "B_ff", "B_sram", "read_ports", "write_ports", "O_pose", "O_event",
        "II_event", "critical_depth", "pipeline_bits", "max_wire_width",
        "numeric_risk", "state_class", "compute_class", "pipeline_class",
        "endpoint_target_ns", "event_lanes"
      ],
      "properties": {
        "B_ff": {"$ref": "#/$defs/nonnegative_integer"},
        "B_sram": {"$ref": "#/$defs/nonnegative_integer"},
        "read_ports": {"$ref": "#/$defs/nonnegative_integer"},
        "write_ports": {"$ref": "#/$defs/nonnegative_integer"},
        "O_pose": {"$ref": "#/$defs/operation_map"},
        "O_event": {"$ref": "#/$defs/operation_map"},
        "II_event": {"type": "integer", "minimum": 1},
        "critical_depth": {"type": "integer", "minimum": 1},
        "pipeline_bits": {"$ref": "#/$defs/nonnegative_integer"},
        "max_wire_width": {"type": "integer", "minimum": 1},
        "numeric_risk": {"enum": ["N0", "N1", "N2", "N3"]},
        "state_class": {"enum": ["S0", "S1", "S2", "S3"]},
        "compute_class": {"enum": ["C0", "C1", "C2", "C3", "C4"]},
        "pipeline_class": {"enum": ["P0", "P1", "P2", "P3"]},
        "endpoint_target_ns": {"const": 6.5},
        "event_lanes": {"const": 2}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["E_A_S", "E_P_S", "I_P_A", "Delta_P_A"],
      "properties": {
        "E_A_S": {"$ref": "#/$defs/finite_number"},
        "E_P_S": {"$ref": "#/$defs/finite_number"},
        "I_P_A": {"$ref": "#/$defs/finite_number"},
        "Delta_P_A": {"$ref": "#/$defs/finite_number"}
      }
    },
    "fallback_reasons": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/nonnegative_integer"}
    },
    "group_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group", "window_count", "query_event_count", "loss_s_sum", "loss_a_sum",
        "loss_p_sum", "pooled", "equal_window", "positive_windows_vs_s",
        "positive_windows_vs_a", "baseline_sensor_waste_events",
        "baseline_sensor_waste_rate", "candidate_sensor_waste_events",
        "candidate_sensor_waste_rate", "incremental_waste_events",
        "incremental_waste_rate", "candidate_use_events", "candidate_use_rate",
        "fallback_events", "fallback_rate", "fallback_reasons",
        "candidate_use_sensor_waste_events", "candidate_use_sensor_waste_rate",
        "quality_harm_mass"
      ],
      "properties": {
        "group": {"enum": ["OVERALL", "LOW", "MID", "HIGH"]},
        "window_count": {"type": "integer", "minimum": 1},
        "query_event_count": {"type": "integer", "minimum": 1},
        "loss_s_sum": {"type": "number", "exclusiveMinimum": 0},
        "loss_a_sum": {"type": "number", "exclusiveMinimum": 0},
        "loss_p_sum": {"type": "number", "minimum": 0},
        "pooled": {"$ref": "#/$defs/effects"},
        "equal_window": {"$ref": "#/$defs/effects"},
        "positive_windows_vs_s": {"$ref": "#/$defs/nonnegative_integer"},
        "positive_windows_vs_a": {"$ref": "#/$defs/nonnegative_integer"},
        "baseline_sensor_waste_events": {"$ref": "#/$defs/nonnegative_integer"},
        "baseline_sensor_waste_rate": {"$ref": "#/$defs/rate"},
        "candidate_sensor_waste_events": {"$ref": "#/$defs/nonnegative_integer"},
        "candidate_sensor_waste_rate": {"$ref": "#/$defs/rate"},
        "incremental_waste_events": {"$ref": "#/$defs/nonnegative_integer"},
        "incremental_waste_rate": {"$ref": "#/$defs/rate"},
        "candidate_use_events": {"$ref": "#/$defs/nonnegative_integer"},
        "candidate_use_rate": {"$ref": "#/$defs/rate"},
        "fallback_events": {"$ref": "#/$defs/nonnegative_integer"},
        "fallback_rate": {"$ref": "#/$defs/rate"},
        "fallback_reasons": {"$ref": "#/$defs/fallback_reasons"},
        "candidate_use_sensor_waste_events": {"$ref": "#/$defs/nonnegative_integer"},
        "candidate_use_sensor_waste_rate": {
          "oneOf": [{"$ref": "#/$defs/rate"}, {"type": "null"}]
        },
        "quality_harm_mass": {"type": "number", "minimum": 0}
      }
    },
    "group_overall": {"allOf": [{"$ref": "#/$defs/group_base"}, {"properties": {"group": {"const": "OVERALL"}}}]},
    "group_low": {"allOf": [{"$ref": "#/$defs/group_base"}, {"properties": {"group": {"const": "LOW"}}}]},
    "group_mid": {"allOf": [{"$ref": "#/$defs/group_base"}, {"properties": {"group": {"const": "MID"}}}]},
    "group_high": {"allOf": [{"$ref": "#/$defs/group_base"}, {"properties": {"group": {"const": "HIGH"}}}]},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id", "motion_bin", "query_event_count", "query_event_ids_sha256",
        "candidate_output_events_sha256", "loss_s_sum", "loss_a_sum", "loss_p_sum",
        "E_A_S", "E_P_S", "I_P_A", "Delta_P_A", "positive_vs_s",
        "positive_vs_a", "candidate_use_events", "fallback_events",
        "fallback_reasons"
      ],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "motion_bin": {"enum": ["LOW", "MID", "HIGH"]},
        "query_event_count": {"type": "integer", "minimum": 1},
        "query_event_ids_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_output_events_sha256": {"$ref": "#/$defs/sha256"},
        "loss_s_sum": {"type": "number", "exclusiveMinimum": 0},
        "loss_a_sum": {"type": "number", "exclusiveMinimum": 0},
        "loss_p_sum": {"type": "number", "minimum": 0},
        "E_A_S": {"$ref": "#/$defs/finite_number"},
        "E_P_S": {"$ref": "#/$defs/finite_number"},
        "I_P_A": {"$ref": "#/$defs/finite_number"},
        "Delta_P_A": {"$ref": "#/$defs/finite_number"},
        "positive_vs_s": {"type": "boolean"},
        "positive_vs_a": {"type": "boolean"},
        "candidate_use_events": {"$ref": "#/$defs/nonnegative_integer"},
        "fallback_events": {"$ref": "#/$defs/nonnegative_integer"},
        "fallback_reasons": {"$ref": "#/$defs/fallback_reasons"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accuracy_and_waste", "model_accuracy_verdict",
        "model_accuracy_gate_pass",
        "synthetic_pass_supplied", "promotion_authorized",
        "hardware_estimate_boundary_met", "rtl_ppa_authorized"
      ],
      "properties": {
        "accuracy_and_waste": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overall_I_P_A_positive", "MID_I_P_A_positive", "HIGH_I_P_A_positive",
            "LOW_I_P_A_not_below_minus_0p25pct", "sensor_waste_not_worse_than_A"
          ],
          "properties": {
            "overall_I_P_A_positive": {"type": "boolean"},
            "MID_I_P_A_positive": {"type": "boolean"},
            "HIGH_I_P_A_positive": {"type": "boolean"},
            "LOW_I_P_A_not_below_minus_0p25pct": {"type": "boolean"},
            "sensor_waste_not_worse_than_A": {"type": "boolean"}
          }
        },
        "model_accuracy_verdict": {
          "enum": ["MODEL_ACCURACY_PASS", "MODEL_ACCURACY_FAIL"]
        },
        "model_accuracy_gate_pass": {"type": "boolean"},
        "synthetic_pass_supplied": {"const": false},
        "promotion_authorized": {"const": false},
        "hardware_estimate_boundary_met": {"const": false},
        "rtl_ppa_authorized": {"const": false}
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_only", "candidate_executed_by_runner",
        "source_selection_changed", "filter_or_selector_evaluated",
        "external_data_evaluated", "rtl_evaluated", "ppa_evaluated"
      ],
      "properties": {
        "development_only": {"const": true},
        "candidate_executed_by_runner": {"const": false},
        "source_selection_changed": {"const": false},
        "filter_or_selector_evaluated": {"const": false},
        "external_data_evaluated": {"const": false},
        "rtl_evaluated": {"const": false},
        "ppa_evaluated": {"const": false}
      }
    }
  }
}
