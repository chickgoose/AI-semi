    "execution_input_aggregate_sha256": {"$ref": "#/$defs/sha256"}, "neutral_input_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_output_schema": {"type": "string", "minLength": 1}, "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
