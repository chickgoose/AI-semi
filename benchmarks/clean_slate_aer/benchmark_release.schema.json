{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aer-address-only-benchmark-release-v7.schema.json",
  "title": "Detached address-only AER benchmark release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "release_kind", "binding", "bootstrap", "policy", "suite_policy", "generator",
    "preparer", "testbench", "native_bindings", "ppa_registry", "runners",
    "tool_helpers", "official_manifests", "golden", "trace_abi", "analyzers",
    "executed_receipts"
  ],
  "properties": {
    "schema": {"const": "aer-address-only-benchmark-release-v7"},
    "release_kind": {"const": "current"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commit", "tree"],
      "properties": {
        "kind": {"enum": ["commit", "tree"]},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "commit"}}},
          "then": {"properties": {"commit": {"type": "string"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "tree"}}},
          "then": {"properties": {"commit": {"type": "null"}}}
        }
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator", "git_executable", "python_executable"],
      "properties": {
        "validator": {"$ref": "#/$defs/artifact"},
        "git_executable": {"$ref": "#/$defs/executable"},
        "python_executable": {"$ref": "#/$defs/executable"}
      }
    },
    "policy": {"$ref": "#/$defs/artifact"},
    "suite_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_full_count", "expected_capacity_count", "required_run_names"],
      "properties": {
        "expected_full_count": {"const": 50},
        "expected_capacity_count": {"const": 22},
        "required_run_names": {
          "type": "array",
          "prefixItems": [
            {"const": "mixed_phase_always_ready_identity"},
            {"const": "mixed_phase_always_ready_bit_reverse"}
          ],
          "items": false
        }
      }
    },
    "generator": {"$ref": "#/$defs/versionedArtifact"},
    "preparer": {"$ref": "#/$defs/artifact"},
    "testbench": {"$ref": "#/$defs/artifact"},
    "native_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "ppa_registry": {"$ref": "#/$defs/artifact"},
    "runners": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "tool_helpers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "official_manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_n16", "capacity_n16"],
      "properties": {
        "full_n16": {"$ref": "#/$defs/fullManifestArtifact"},
        "capacity_n16": {"$ref": "#/$defs/capacityManifestArtifact"}
      }
    },
    "golden": {"$ref": "#/$defs/goldenArtifact"},
    "trace_abi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "identity_mode", "header_fields", "event_fields", "required_relation"],
      "properties": {
        "version": {"const": 4},
        "identity_mode": {"const": "address_only"},
        "header_fields": {
          "type": "array",
          "prefixItems": [
            {"const": "version"}, {"const": "event_count"},
            {"const": "stim_cycles"}, {"const": "source_count"},
            {"const": "load_milli"}, {"const": "sink_mode"},
            {"const": "sink_arg0"}, {"const": "sink_arg1"}, {"const": "seed"}
          ],
          "items": false
        },
        "event_fields": {
          "type": "array",
          "prefixItems": [
            {"const": "occurrence_cycle"}, {"const": "tb_only_event_id"},
            {"const": "logical_source"}, {"const": "address"},
            {"const": "deadline"}
          ],
          "items": false
        },
        "required_relation": {"const": "address == logical_source"}
      }
    },
    "analyzers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "executed_receipts": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^|/)(results?|logs?)(/|$)|\\.log$"}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"const": "4.0"}
      }
    },
    "fullManifestArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "run_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_count": {"const": 50}
      }
    },
    "capacityManifestArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "run_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "run_count": {"const": 22}
      }
    },
    "goldenArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "generator_version", "run_count"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generator_version": {"const": "4.0"},
        "run_count": {"const": 50}
      }
    }
  }
}
