{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redred.local/schemas/uzh-mc-wtb-motion-v3-preregistration-v1.json",
  "title": "REDRED UZH MC-WTB motion metric v3 preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assay_id",
    "status",
    "registration",
    "legacy_v2",
    "input_authority",
    "partition",
    "same_reference",
    "denominator",
    "primary",
    "secondaries",
    "controls",
    "coverage_escape",
    "bootstrap",
    "decision_policy",
    "claim_scope"
  ],
  "properties": {
    "schema": {
      "const": "redred.uzh_mc_wtb_motion_v3.preregistration/v1"
    },
    "assay_id": {
      "type": "string",
      "pattern": "^UZH-MCWTB-METRIC-V3-[A-Z0-9_-]+$"
    },
    "status": {
      "enum": [
        "DEVELOPMENT_PREREGISTRATION_ONLY_NO_CONFIRMATORY_RESULT",
        "HOLDOUT_PREREGISTRATION_FROZEN_NO_RESULT"
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "confirmatory_eligible",
        "development_data_previously_observed",
        "frozen_before_partition_access",
        "change_policy"
      ],
      "properties": {
        "stage": {
          "enum": ["DEVELOPMENT", "HOLDOUT"]
        },
        "confirmatory_eligible": {
          "type": "boolean"
        },
        "development_data_previously_observed": {
          "type": "boolean"
        },
        "frozen_before_partition_access": {
          "type": "boolean"
        },
        "change_policy": {
          "const": "ANY_METRIC_THRESHOLD_CONTROL_PARTITION_OR_SERIALIZATION_CHANGE_REQUIRES_NEW_ASSAY_VERSION"
        }
      }
    },
    "legacy_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserved",
        "package_path",
        "preregistration_path",
        "preregistration_sha256",
        "result_reinterpretation_forbidden",
        "v3_result_is_not_v2_result"
      ],
      "properties": {
        "preserved": {"const": true},
        "package_path": {"const": "benchmarks/redred_uzh_mc_wtb_motion"},
        "preregistration_path": {"const": "benchmarks/redred_uzh_mc_wtb_motion/paret_preregistered.json"},
        "preregistration_sha256": {"$ref": "#/$defs/sha256"},
        "result_reinterpretation_forbidden": {"const": true},
        "v3_result_is_not_v2_result": {"const": true}
      }
    },
    "input_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "sensor",
        "events_member_sha256",
        "poses_member_sha256",
        "calibration_member_sha256",
        "six_arm_artifact_sha256",
        "source_pose_meaning",
        "quaternion_order",
        "translation_policy"
      ],
      "properties": {
        "dataset": {"const": "UZH_DAVIS_SHAPES_ROTATION"},
        "sensor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_px", "height_px", "calibration_model"],
          "properties": {
            "width_px": {"const": 240},
            "height_px": {"const": 180},
            "calibration_model": {"const": "opencv_pinhole_radtan"}
          }
        },
        "events_member_sha256": {"$ref": "#/$defs/sha256"},
        "poses_member_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_member_sha256": {"$ref": "#/$defs/sha256"},
        "six_arm_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "source_pose_meaning": {"const": "camera_to_world_T_WC"},
        "quaternion_order": {"const": "xyzw"},
        "translation_policy": {"const": "preserved_not_applied_orientation_only_assay"}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "partition_id",
        "anchor",
        "query",
        "holdout_separation"
      ],
      "properties": {
        "role": {"enum": ["DEVELOPMENT", "HOLDOUT"]},
        "partition_id": {"type": "string", "minLength": 1},
        "anchor": {"$ref": "#/$defs/cohortWindow"},
        "query": {"$ref": "#/$defs/cohortWindow"},
        "holdout_separation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "development_partition_id",
            "holdout_required",
            "holdout_selection_status",
            "holdout_results_present",
            "exact_byte_pins_required_before_access",
            "event_id_disjoint_from_development",
            "time_interval_disjoint_from_development",
            "metric_changes_after_holdout_selection_forbidden"
          ],
          "properties": {
            "development_partition_id": {"type": "string", "minLength": 1},
            "holdout_required": {"const": true},
            "holdout_selection_status": {
              "enum": ["NOT_SELECTED_IN_DEVELOPMENT_REGISTRATION", "EXACTLY_PINNED_BEFORE_ACCESS"]
            },
            "holdout_results_present": {"const": false},
            "exact_byte_pins_required_before_access": {"const": true},
            "event_id_disjoint_from_development": {"const": true},
            "time_interval_disjoint_from_development": {"const": true},
            "metric_changes_after_holdout_selection_forbidden": {"const": true}
          }
        }
      }
    },
    "same_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_timestamp_ns",
        "reference_axes",
        "canonical_formula",
        "canonical_anchor_transform",
        "query_transform_by_arm",
        "primary_domain",
        "reference_image_bounds_define_world_validity"
      ],
      "properties": {
        "reference_timestamp_ns": {"type": "integer", "minimum": 0},
        "reference_axes": {"const": "camera_axes_at_reference_timestamp"},
        "canonical_formula": {
          "const": "normalize(transpose(R_WC(reference_timestamp_ns))*R_WC(sample_timestamp_ns)*undistorted_sensor_ray)"
        },
        "canonical_anchor_transform": {"const": "CANONICAL_FORMULA_AT_EACH_ANCHOR_TIMESTAMP"},
        "query_transform_by_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["RAW", "SENSOR_FIXED", "MC_CORRECT", "MC_WRONG", "MC_DELAYED", "RETIRE_WARP"],
          "properties": {
            "RAW": {"const": "IDENTITY_SENSOR_RAY_INTERPRETED_IN_REFERENCE_AXES_INTEGRITY_ONLY"},
            "SENSOR_FIXED": {"const": "IDENTITY_SENSOR_RAY_INTERPRETED_IN_REFERENCE_AXES"},
            "MC_CORRECT": {"const": "CANONICAL_FORMULA_AT_OCCURRENCE_TIMESTAMP"},
            "MC_WRONG": {"const": "TRANSPOSE_OF_CANONICAL_RELATIVE_ROTATION_AT_OCCURRENCE_TIMESTAMP"},
            "MC_DELAYED": {"const": "CANONICAL_FORMULA_AT_OCCURRENCE_TIMESTAMP_MINUS_FIXED_DELAY"},
            "RETIRE_WARP": {"const": "CANONICAL_FORMULA_AT_OBSERVED_RETIRE_TIMESTAMP"}
          }
        },
        "primary_domain": {"const": "UNIT_RAYS_IN_REFERENCE_CAMERA_AXES"},
        "reference_image_bounds_define_world_validity": {"const": false}
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arms",
        "exact_ordered_query_records",
        "ordered_dataset_event_index_sha256",
        "ordered_id_hash_grammar",
        "same_exact_ordered_ids_for_every_arm",
        "one_record_contains_every_arm",
        "missing_policy",
        "duplicate_policy",
        "reorder_policy",
        "arm_local_filtering",
        "polarity_treatment",
        "primary_world_valid_records_required"
      ],
      "properties": {
        "arms": {
          "type": "array",
          "prefixItems": [
            {"const": "RAW"},
            {"const": "SENSOR_FIXED"},
            {"const": "MC_CORRECT"},
            {"const": "MC_WRONG"},
            {"const": "MC_DELAYED"},
            {"const": "RETIRE_WARP"}
          ],
          "minItems": 6,
          "maxItems": 6
        },
        "exact_ordered_query_records": {"type": "integer", "minimum": 1},
        "ordered_dataset_event_index_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_id_hash_grammar": {"const": "ascii_decimal_dataset_event_index_plus_lf_per_record"},
        "same_exact_ordered_ids_for_every_arm": {"const": true},
        "one_record_contains_every_arm": {"const": true},
        "missing_policy": {"const": "HARD_FAIL"},
        "duplicate_policy": {"const": "HARD_FAIL"},
        "reorder_policy": {"const": "HARD_FAIL"},
        "arm_local_filtering": {"const": "FORBIDDEN"},
        "polarity_treatment": {"const": "SAME_POLARITY_ONLY_REPORTED_SEPARATELY_AND_COMBINED_WITH_EXACT_EVENT_WEIGHT"},
        "primary_world_valid_records_required": {"type": "integer", "minimum": 1}
      }
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "metric_family",
        "canonical_anchor",
        "control_arm",
        "treatment_arm",
        "per_event_distance",
        "aggregation",
        "lower_is_better",
        "effect",
        "candidate_minimum_relative_reduction",
        "candidate_one_sided_confidence",
        "development_can_emit_confirmatory_pass"
      ],
      "properties": {
        "metric_id": {"const": "V3_PRIMARY_SAME_REFERENCE_ANGULAR_NN"},
        "metric_family": {"const": "same_polarity_query_to_canonical_warped_anchor_angular_nearest_neighbor"},
        "canonical_anchor": {"const": "EVERY_ANCHOR_WARPED_BY_CANONICAL_FORMULA_TO_REFERENCE_AXES"},
        "control_arm": {"const": "SENSOR_FIXED"},
        "treatment_arm": {"const": "MC_CORRECT"},
        "per_event_distance": {"const": "acos(clamp(dot(query_unit_ray,nearest_same_polarity_anchor_unit_ray),-1,1))_radians"},
        "aggregation": {"const": "ARITHMETIC_MEAN_OVER_EXACT_ORDERED_QUERY_DENOMINATOR"},
        "lower_is_better": {"const": true},
        "effect": {"const": "1-mean_MC_CORRECT/mean_SENSOR_FIXED"},
        "candidate_minimum_relative_reduction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "candidate_one_sided_confidence": {"const": 0.975},
        "development_can_emit_confirmatory_pass": {"const": false}
      }
    },
    "secondaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symmetric_chamfer", "per_polarity", "iwe_concentration"],
      "properties": {
        "symmetric_chamfer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric_id", "definition", "role"],
          "properties": {
            "metric_id": {"const": "V3_SECONDARY_SYMMETRIC_ANGULAR_CHAMFER"},
            "definition": {"const": "half(mean_query_to_anchor_angular_NN+mean_anchor_to_query_angular_NN)_same_polarity"},
            "role": {"const": "DESCRIPTIVE_ONLY_NO_PRIMARY_SUBSTITUTION"}
          }
        },
        "per_polarity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric_id", "values", "role"],
          "properties": {
            "metric_id": {"const": "V3_SECONDARY_PRIMARY_COMPONENTS_BY_POLARITY"},
            "values": {
              "type": "array",
              "prefixItems": [{"const": 0}, {"const": 1}],
              "minItems": 2,
              "maxItems": 2
            },
            "role": {"const": "DESCRIPTIVE_ONLY_NO_PRIMARY_SUBSTITUTION"}
          }
        },
        "iwe_concentration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric_id",
            "coordinate_domain",
            "canvas",
            "outside_canvas_policy",
            "splat",
            "polarity_channels",
            "mass_per_event",
            "metric",
            "normalization",
            "grid_phase_offsets_px",
            "report_raw_energy",
            "higher_is_better",
            "role"
          ],
          "properties": {
            "metric_id": {"const": "V3_SECONDARY_PADDED_IWE_CROSS_EVENT_CONCENTRATION"},
            "coordinate_domain": {"const": "CONTINUOUS_REFERENCE_IMAGE_PROJECTION_VALID_OOF_RETAINED"},
            "canvas": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x_min_inclusive", "x_max_inclusive", "y_min_inclusive", "y_max_inclusive"],
              "properties": {
                "x_min_inclusive": {"type": "integer"},
                "x_max_inclusive": {"type": "integer"},
                "y_min_inclusive": {"type": "integer"},
                "y_max_inclusive": {"type": "integer"}
              }
            },
            "outside_canvas_policy": {"const": "HOLD_CANVAS_INSUFFICIENT_NEVER_DROP_CLIP_OR_RESIZE"},
            "splat": {"const": "BILINEAR_FOUR_PIXEL_MASS_PRESERVING"},
            "polarity_channels": {"const": "TWO_SEPARATE_CHANNELS_NO_SIGN_CANCELLATION"},
            "mass_per_event": {"const": 1},
            "metric": {"const": "sum_I_squared_minus_sum_per_event_kernel_self_energy"},
            "normalization": {"const": "ordered_same_polarity_event_pairs_N0_times_N0_minus1_plus_N1_times_N1_minus1"},
            "grid_phase_offsets_px": {
              "type": "array",
              "prefixItems": [{"const": 0.0}, {"const": 0.25}, {"const": 0.5}, {"const": 0.75}],
              "minItems": 4,
              "maxItems": 4
            },
            "report_raw_energy": {"const": true},
            "higher_is_better": {"const": true},
            "role": {"const": "DESCRIPTIVE_ONLY_NO_PRIMARY_SUBSTITUTION"}
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_integrity",
        "wrong_direction",
        "delayed_pose",
        "retire_pose",
        "familywise_alpha",
        "bonferroni_control_count",
        "control_lower_confidence",
        "negative_control_failure_policy"
      ],
      "properties": {
        "raw_integrity": {
          "const": "RAW_AND_SENSOR_FIXED_IDENTITY_QUERY_RAYS_MUST_MATCH_EXACTLY"
        },
        "wrong_direction": {
          "const": "MC_CORRECT_PRIMARY_COST_MUST_BE_LOWER_THAN_MC_WRONG_WITH_POSITIVE_CONTROL_LOWER_BOUND"
        },
        "delayed_pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delay_ns", "rule"],
          "properties": {
            "delay_ns": {"type": "integer", "minimum": 1},
            "rule": {"const": "MC_CORRECT_PRIMARY_COST_MUST_BE_LOWER_THAN_MC_DELAYED_WITH_POSITIVE_CONTROL_LOWER_BOUND"}
          }
        },
        "retire_pose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamp_authority", "informative_p95_angular_separation_min_degrees", "uninformative_policy", "rule_if_informative"],
          "properties": {
            "timestamp_authority": {"const": "EXACT_INDEPENDENTLY_INSPECTED_OBSERVED_RETIRE_RECEIPT_FOR_EVERY_QUERY_ID"},
            "informative_p95_angular_separation_min_degrees": {"type": "number", "exclusiveMinimum": 0},
            "uninformative_policy": {"const": "HOLD_RETIRE_CONTROL_UNINFORMATIVE"},
            "rule_if_informative": {"const": "MC_CORRECT_PRIMARY_COST_MUST_BE_LOWER_THAN_RETIRE_WARP_WITH_POSITIVE_CONTROL_LOWER_BOUND"}
          }
        },
        "familywise_alpha": {"const": 0.05},
        "bonferroni_control_count": {"const": 3},
        "control_lower_confidence": {"const": 0.9833333333333333},
        "negative_control_failure_policy": {"const": "HOLD_OR_FAIL_CONTROL_NO_MOTION_BENEFIT_PASS"}
      }
    },
    "coverage_escape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_query_denominator",
        "exactly_one_disposition_per_arm_event",
        "dispositions",
        "valid_reference_image_oof_policy",
        "invalid_geometry_policy",
        "report_counts_by_arm_and_polarity",
        "report_ordered_id_hash_per_disposition",
        "scalar_accuracy_penalty_for_oof_or_escape",
        "coverage_is_separate_from_primary_accuracy"
      ],
      "properties": {
        "full_query_denominator": {"type": "integer", "minimum": 1},
        "exactly_one_disposition_per_arm_event": {"const": true},
        "dispositions": {
          "type": "array",
          "prefixItems": [
            {"const": "WORLD_DOMAIN_VALID_REFERENCE_IMAGE_IN_FOV"},
            {"const": "WORLD_DOMAIN_VALID_REFERENCE_IMAGE_OOF"},
            {"const": "BEHIND_REFERENCE_ESCAPE"},
            {"const": "INVALID_GEOMETRY_ESCAPE"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "valid_reference_image_oof_policy": {"const": "KEEP_WORLD_RAY_KEEP_CONTINUOUS_PADDED_PROJECTION_NEVER_PENALIZE_OR_DROP"},
        "invalid_geometry_policy": {"const": "RECORD_ESCAPE_AND_HOLD_PRIMARY_IF_EXACT_WORLD_VALID_DENOMINATOR_IS_NOT_MET"},
        "report_counts_by_arm_and_polarity": {"const": true},
        "report_ordered_id_hash_per_disposition": {"const": true},
        "scalar_accuracy_penalty_for_oof_or_escape": {"const": false},
        "coverage_is_separate_from_primary_accuracy": {"const": true}
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resamples",
        "unit",
        "method",
        "block_length_clusters",
        "sampled_clusters",
        "seed_text",
        "seed_derivation",
        "one_sided_primary_lower_quantile"
      ],
      "properties": {
        "resamples": {"type": "integer", "minimum": 1000},
        "unit": {"const": "EQUAL_TIMESTAMP_CLUSTER"},
        "method": {"const": "CIRCULAR_MOVING_BLOCK"},
        "block_length_clusters": {"type": "integer", "minimum": 1},
        "sampled_clusters": {"const": "ceil(cluster_count/block_length_clusters)_blocks_then_truncate_to_cluster_count"},
        "seed_text": {"type": "string", "minLength": 1},
        "seed_derivation": {"const": "UNSIGNED_INTEGER_FROM_FIRST_16_HEX_DIGITS_OF_SHA256"},
        "one_sided_primary_lower_quantile": {"const": 0.025}
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_status",
        "development_promotion_forbidden",
        "future_holdout_candidate_primary_gate",
        "primary_denominator_mismatch",
        "control_gate_required",
        "coverage_report_required",
        "multiple_primary_metrics_forbidden",
        "secondary_substitution_forbidden"
      ],
      "properties": {
        "development_status": {"const": "DEVELOPMENT_METRIC_ESTIMATE_ONLY"},
        "development_promotion_forbidden": {"const": true},
        "future_holdout_candidate_primary_gate": {"const": "point_relative_reduction_strictly_greater_than_candidate_minimum_AND_one_sided_97_5_lower_bound_strictly_greater_than_candidate_minimum"},
        "primary_denominator_mismatch": {"const": "HOLD_EXACT_DENOMINATOR_NOT_MET"},
        "control_gate_required": {"const": true},
        "coverage_report_required": {"const": true},
        "multiple_primary_metrics_forbidden": {"const": true},
        "secondary_substitution_forbidden": {"const": true}
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_metric_contract",
        "confirmatory_motion_benefit",
        "holdout_result",
        "dataset_generalization",
        "codec_or_bandwidth",
        "rtl",
        "synthesis_timing",
        "area",
        "power",
        "place_and_route",
        "phase5_architecture_started",
        "novelty"
      ],
      "properties": {
        "development_metric_contract": {"const": true},
        "confirmatory_motion_benefit": {"const": false},
        "holdout_result": {"const": false},
        "dataset_generalization": {"const": false},
        "codec_or_bandwidth": {"const": false},
        "rtl": {"const": false},
        "synthesis_timing": {"const": false},
        "area": {"const": false},
        "power": {"const": false},
        "place_and_route": {"const": false},
        "phase5_architecture_started": {"const": false},
        "novelty": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registration": {
            "properties": {"stage": {"const": "DEVELOPMENT"}},
            "required": ["stage"]
          }
        }
      },
      "then": {
        "properties": {
          "status": {"const": "DEVELOPMENT_PREREGISTRATION_ONLY_NO_CONFIRMATORY_RESULT"},
          "registration": {
            "properties": {
              "confirmatory_eligible": {"const": false},
              "development_data_previously_observed": {"const": true},
              "frozen_before_partition_access": {"const": false}
            }
          },
          "partition": {
            "properties": {
              "role": {"const": "DEVELOPMENT"},
              "holdout_separation": {
                "properties": {
                  "holdout_selection_status": {"const": "NOT_SELECTED_IN_DEVELOPMENT_REGISTRATION"}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {"const": "HOLDOUT_PREREGISTRATION_FROZEN_NO_RESULT"},
          "registration": {
            "properties": {
              "confirmatory_eligible": {"const": true},
              "development_data_previously_observed": {"const": false},
              "frozen_before_partition_access": {"const": true}
            }
          },
          "partition": {
            "properties": {
              "role": {"const": "HOLDOUT"},
              "holdout_separation": {
                "properties": {
                  "holdout_selection_status": {"const": "EXACTLY_PINNED_BEFORE_ACCESS"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cohortWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_timestamp_ns_inclusive",
        "end_timestamp_ns_exclusive",
        "record_count",
        "first_dataset_event_index",
        "last_dataset_event_index",
        "ordered_dataset_event_index_sha256"
      ],
      "properties": {
        "start_timestamp_ns_inclusive": {"type": "integer", "minimum": 0},
        "end_timestamp_ns_exclusive": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 1},
        "first_dataset_event_index": {"type": "integer", "minimum": 0},
        "last_dataset_event_index": {"type": "integer", "minimum": 0},
        "ordered_dataset_event_index_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
