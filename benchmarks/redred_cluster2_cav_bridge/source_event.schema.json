{
  "$id": "https://redred.invalid/schemas/cluster2_cav_bridge_source_event_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causal_pose_source_index": {"minimum": 0, "type": "integer"},
    "event_content_sha256": {"$ref": "#/$defs/sha256"},
    "event_id": {"minimum": 0, "type": "integer"},
    "is_query": {"type": "boolean"},
    "ordinal": {"minimum": 0, "type": "integer"},
    "polarity": {"enum": [0, 1], "type": "integer"},
    "schema": {"const": "redred.cluster2_cav_bridge.source_event/v1"},
    "sensor_ray": {"items": {"type": "number"}, "maxItems": 3, "minItems": 3, "type": "array"},
    "source_index": {"maximum": 15, "minimum": 0, "type": "integer"},
    "timestamp_ns": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "transform_guard_valid": {"type": "boolean"},
    "window_id": {"$ref": "#/$defs/identifier"}
  },
  "required": [
    "schema", "event_id", "ordinal", "timestamp_ns", "source_index",
    "polarity", "window_id", "is_query", "sensor_ray",
    "causal_pose_source_index", "transform_guard_valid", "event_content_sha256"
  ],
  "title": "REDRED Cluster2/CAV source sidecar event v1",
  "type": "object",
  "$defs": {
    "identifier": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "type": "string"},
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
