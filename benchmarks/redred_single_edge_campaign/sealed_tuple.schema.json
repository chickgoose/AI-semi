{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redred_single_edge_sealed_tuple_publication_v2",
  "title": "Campaign-consumable sealed replay publication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "status",
    "source_class",
    "canonical_redred_traffic",
    "official_contest_traffic",
    "p6_evidence_used",
    "release_status",
    "selection_status",
    "producer",
    "rtl",
    "bundle",
    "result"
  ],
  "properties": {
    "schema": {"type": "string", "minLength": 1},
    "evidence_class": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "source_class": {
      "enum": ["TEAM_DEFINED_SYNTHETIC", "PUBLIC_PROJECTED_EXTENSION"]
    },
    "canonical_redred_traffic": {"type": "boolean"},
    "official_contest_traffic": {"const": false},
    "p6_evidence_used": {"const": false},
    "release_status": {"const": "HOLD"},
    "selection_status": {"const": "HOLD"},
    "producer": {"$ref": "#/$defs/provenance"},
    "rtl": {"$ref": "#/$defs/rtl"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256", "size_bytes", "manifest_member", "manifest_sha256", "entry_count"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "manifest_member": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "entry_count": {"type": "integer", "minimum": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member", "sha256", "semantic_sha256", "size_bytes"],
      "properties": {
        "member": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit", "tree", "verifier_sha256", "schema_sha256",
        "runner_sha256", "testbench_sha256", "tool_pins_sha256", "inventory"
      ],
      "properties": {
        "commit": {"$ref": "#/$defs/git"},
        "tree": {"$ref": "#/$defs/git"},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "testbench_sha256": {"$ref": "#/$defs/sha256"},
        "tool_pins_sha256": {"$ref": "#/$defs/sha256"},
        "inventory": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "blob_sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "blob_sha256": {"$ref": "#/$defs/git"}
            }
          }
        }
      }
    },
    "rtl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "source_tree", "integration_commit", "integration_tree", "source_inventory", "integration_inventory"],
      "properties": {
        "source_commit": {"$ref": "#/$defs/git"},
        "source_tree": {"$ref": "#/$defs/git"},
        "integration_commit": {"$ref": "#/$defs/git"},
        "integration_tree": {"$ref": "#/$defs/git"},
        "source_inventory": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "blob_sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "blob_sha256": {"$ref": "#/$defs/git"}
            }
          }
        },
        "integration_inventory": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "path", "blob_sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "blob_sha256": {"$ref": "#/$defs/git"}
            }
          }
        }
      }
    }
  }
}
