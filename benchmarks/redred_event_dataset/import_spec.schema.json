{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/redred-event-import-v1.schema.json",
  "title": "REDRED dataset-neutral event import specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dataset_label",
    "source",
    "sensor",
    "input",
    "cycle_mapping",
    "bounds_policy"
  ],
  "properties": {
    "schema": {"const": "redred-event-import-v1"},
    "dataset_label": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "input": {"oneOf": [
      {"$ref": "#/$defs/canonicalInput"},
      {"$ref": "#/$defs/delimitedInput"},
      {"$ref": "#/$defs/samsungHoldInput"}
    ]},
    "cycle_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period_ns", "origin", "deadline_slack_cycles"],
      "properties": {
        "period_ns": {"$ref": "#/$defs/exactDecimal"},
        "origin": {"const": "first_event"},
        "deadline_slack_cycles": {"type": "integer", "minimum": 0}
      }
    },
    "bounds_policy": {"enum": ["reject", "clip"]}
  },
  "$defs": {
    "exactDecimal": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"}
      ]
    },
    "commonInputProperties": {
      "type": "object",
      "properties": {
        "time_unit": {"enum": ["s", "ms", "us", "ns"]},
        "polarity_encoding": {"enum": ["minus_plus_one", "zero_one"]}
      }
    },
    "canonicalInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "time_unit", "polarity_encoding"],
      "properties": {
        "format": {"const": "canonical_jsonl"},
        "time_unit": {"enum": ["s", "ms", "us", "ns"]},
        "polarity_encoding": {"enum": ["minus_plus_one", "zero_one"]}
      }
    },
    "delimitedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "time_unit",
        "polarity_encoding",
        "delimiter",
        "header",
        "comment_prefix",
        "columns"
      ],
      "properties": {
        "format": {"const": "generic_delimited"},
        "time_unit": {"enum": ["s", "ms", "us", "ns"]},
        "polarity_encoding": {"enum": ["minus_plus_one", "zero_one"]},
        "delimiter": {
          "oneOf": [
            {"const": "whitespace"},
            {"type": "string", "minLength": 1, "maxLength": 1}
          ]
        },
        "header": {"type": "boolean"},
        "comment_prefix": {"type": ["string", "null"], "minLength": 1},
        "columns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamp", "x", "y", "polarity"],
          "properties": {
            "timestamp": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]},
            "x": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]},
            "y": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]},
            "polarity": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}]}
          }
        }
      }
    },
    "samsungHoldInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {"const": "samsung_official"}
      },
      "description": "Reserved identifier. The importer emits HOLD and does not parse this format."
    }
  }
}
